# Na Vercel: Settings > Environment Variables (o .env não vai para o Git)
# Zenith Payments API — só no backend, nunca no frontend
ZENITH_PUBLIC_KEY=
ZENITH_SECRET_KEY=
# secret partilhado do webhook (o que cadastrar em POST /integrations/webhooks/endpoints)
ZENITH_WEBHOOK_SECRET=

ADMIN_SENHA=
META_TOKEN=

# Banco dos pedidos (/admin): ligue o Upstash Redis ao projeto em Vercel > Storage.
# Ele cria KV_REST_API_URL e KV_REST_API_TOKEN sozinho. Local, sem isso, usa data/pedidos.json.

# Opcional:
# ZENITH_ENV=sandbox   # padrão: production
