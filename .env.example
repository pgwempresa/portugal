# Copie para .env e preencha. Na Vercel, cadastre as mesmas variáveis em
# Project > Settings > Environment Variables (o .env não vai para o Git).

PORT=3000

# LeonaPay — painel > Integrações. Chaves de sandbox e produção são diferentes.
LEONAPAY_ENV=sandbox
LEONAPAY_API_KEY=
# secret (whsec_...) devolvido ao criar o webhook
LEONAPAY_WEBHOOK_SECRET=

# Prazo para aprovar na app MB WAY (60 a 86400 s)
MBWAY_EXPIRA_SEG=300
